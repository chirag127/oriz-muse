---
import Base from '../layouts/Base.astro'
import Studio from '../components/Studio.tsx'
import '../styles/studio.css'
---

<Base>
  <section class="muse-hero">
    <p class="muse-hero__kicker">The writing atelier</p>
    <h1 class="muse-hero__title">
      Free <em>AI writing studio</em> — stories, poems &amp; lyrics
    </h1>
    <p class="muse-hero__sub">
      Generate, continue, or rewrite prose in any voice. Runs entirely in your
      browser — no upload, no signup, no cost.
    </p>
    <a class="muse-cta" href="#studio">Take up the quill ↓</a>
    <div class="muse-hero__flourish" aria-hidden="true"></div>
  </section>

  <section id="studio">
    <Studio client:load />

    <p class="muse-intro">
      Muse is a free, private AI writing tool for drafting short stories, poetry,
      song lyrics, blog posts, and essays. Seed a topic and it drafts a passage,
      hands you the pen to continue, or recasts your text in a chosen style —
      tuned by genre, tone, and length. A prompt library and saved drafts live
      only on this device.
    </p>
  </section>
</Base>
